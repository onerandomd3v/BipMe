# Development only; never commit actual .env files.
BIPME_DATABASE_URL=postgresql+psycopg://bipme:bipme_local_only@127.0.0.1:5432/bipme
# Server-managed private session. Provision BIPME_CREATOR_ID with the existing creator row.
# Generate BIPME_PRIVATE_LOGIN_SECRET with a cryptographically secure generator (>=32 bytes).
BIPME_ENVIRONMENT=development
BIPME_CREATOR_ID=00000000-0000-0000-0000-000000000000
BIPME_PRIVATE_LOGIN_SECRET=replace-with-at-least-32-random-bytes
BIPME_SESSION_LIFETIME_SECONDS=43200
# false is allowed only for local loopback HTTP development; production requires true.
BIPME_AUTH_COOKIE_SECURE=false
BIPME_APP_ORIGIN=http://127.0.0.1:5173

# Leave X OAuth disabled until COD-344's account ID, access and permissions are verified.
BIPME_X_OAUTH_ENABLED=false
BIPME_X_CLIENT_ID=
BIPME_X_CLIENT_SECRET=
BIPME_X_ALLOWED_USER_ID=
BIPME_X_REDIRECT_URI=http://127.0.0.1:8000/api/auth/x/callback
# JSON map of key-version to Fernet key; keep every key server-side and retain old keys
# during rotation. The active key encrypts new values.
BIPME_TOKEN_ENCRYPTION_KEYS={}
BIPME_ACTIVE_TOKEN_KEY_VERSION=
