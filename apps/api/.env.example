# FastAPI application and worker configuration.
# Copy to .env in apps/api/ and load it into the process environment as shown in
# ../../docs/development.md. This example is not loaded by Python automatically.

# Required for API database access and migrations. Local-only credentials from
# the repository-root compose.yaml; never reuse outside local development.
BIPME_DATABASE_URL=postgresql+psycopg://bipme:bipme_local_only@127.0.0.1:5432/bipme
# Optional, test-only disposable PostgreSQL database. Leave unset for unit tests.
BIPME_TEST_DATABASE_URL=

# Private single-creator session. Provision this creator row in the local DB and
# replace the secret with at least 32 random bytes before private sign-in.
BIPME_ENVIRONMENT=development
BIPME_CREATOR_ID=00000000-0000-0000-0000-000000000000
BIPME_PRIVATE_LOGIN_SECRET=replace-with-at-least-32-random-bytes
BIPME_SESSION_LIFETIME_SECONDS=43200
# false is allowed only for local loopback HTTP; production requires true.
BIPME_AUTH_COOKIE_SECURE=false
BIPME_APP_ORIGIN=http://127.0.0.1:5173

# X OAuth remains disabled until account access, rights, and current pricing are
# verified. Keep every X gate false and pricing field blank until then.
BIPME_X_OAUTH_ENABLED=false
BIPME_X_CLIENT_ID=
BIPME_X_CLIENT_SECRET=
BIPME_X_ALLOWED_USER_ID=
BIPME_X_REDIRECT_URI=http://127.0.0.1:8000/api/auth/x/callback
BIPME_X_IDENTITY_READ_ESTIMATED_COST_USD=
BIPME_X_DAILY_COST_LIMIT_USD=
# JSON map of key-version to Fernet key; keep keys in a server-side secret store.
BIPME_TOKEN_ENCRYPTION_KEYS={}
BIPME_ACTIVE_TOKEN_KEY_VERSION=

# History import, metric snapshots, and publication verification are disabled
# by default. Do not enable without verified X access, rights, current prices,
# and enforceable total/daily/operation limits.
BIPME_X_ACCOUNT_ENTITLEMENT_VERIFIED=false
BIPME_X_HISTORY_IMPORT_ENABLED=false
BIPME_X_HISTORY_DATA_RIGHTS_VERIFIED=false
BIPME_X_HISTORY_REQUEST_COST_USD=
BIPME_X_HISTORY_RESULT_COST_USD=
BIPME_X_HISTORY_PRICING_OBSERVED_AT=
BIPME_X_HISTORY_PRICING_EXPIRES_AT=
BIPME_X_HISTORY_PRICING_SOURCE=
BIPME_X_HISTORY_TOTAL_LIMIT_USD=
BIPME_X_HISTORY_OPERATION_LIMIT_USD=
BIPME_X_HISTORY_IMPORT_LIMIT_USD=
BIPME_X_METRIC_SNAPSHOT_ENABLED=false
BIPME_X_METRIC_SNAPSHOT_DATA_RIGHTS_VERIFIED=false
BIPME_X_METRIC_SNAPSHOT_REQUEST_COST_USD=
BIPME_X_METRIC_SNAPSHOT_TOTAL_LIMIT_USD=
BIPME_X_METRIC_SNAPSHOT_OPERATION_LIMIT_USD=
BIPME_X_METRIC_SNAPSHOT_PER_POST_LIMIT_USD=
BIPME_X_METRIC_SNAPSHOT_PRICING_OBSERVED_AT=
BIPME_X_METRIC_SNAPSHOT_PRICING_EXPIRES_AT=
BIPME_X_METRIC_SNAPSHOT_PRICING_SOURCE=
BIPME_X_PUBLICATION_LINK_ENABLED=false
BIPME_X_PUBLICATION_ACCOUNT_ENTITLEMENT_VERIFIED=false
BIPME_X_PUBLICATION_DATA_RIGHTS_VERIFIED=false
BIPME_X_PUBLICATION_READ_ESTIMATED_COST_USD=
BIPME_X_PUBLICATION_TOTAL_COST_LIMIT_USD=
BIPME_X_PUBLICATION_DAILY_COST_LIMIT_USD=
BIPME_X_PUBLICATION_OPERATION_COST_LIMIT_USD=
BIPME_X_PUBLICATION_IMPORT_COST_LIMIT_USD=
BIPME_X_PUBLICATION_PRICING_OBSERVED_AT=
BIPME_X_PUBLICATION_PRICING_EXPIRES_AT=
BIPME_X_PUBLICATION_PRICING_SOURCE=
# Personal-history report processing is also disabled until platform rights are
# verified for this exact local, deterministic use.
BIPME_X_HISTORY_REPORT_PROCESSING_ALLOWED=false
BIPME_X_HISTORY_REPORT_PROCESSING_VERIFIED_AT=

# Embeddings default to the pinned E5-Small model on local CPU. The model and
# immutable revision are fixed by default; change only after explicit review.
BIPME_EMBEDDING_MODEL=intfloat/multilingual-e5-small
BIPME_EMBEDDING_REVISION=fd1525a9fd15316a2d503bf26ab031a61d056e98
BIPME_EMBEDDING_PROVIDER=local
# For remote mode, use a private HTTPS origin and keep the bearer token server-side.
BIPME_EMBEDDING_REMOTE_URL=
BIPME_EMBEDDING_REMOTE_TOKEN=
BIPME_EMBEDDING_TIMEOUT_SECONDS=10

# Optional Groq report synthesis is disabled by default. Never send real X-derived
# content until source-processing and third-party-transfer rights are verified.
BIPME_REPORT_SYNTHESIS_ENABLED=false
GROQ_API_KEY=
BIPME_REPORT_MODEL=openai/gpt-oss-120b
BIPME_REPORT_PRICING_MODEL=openai/gpt-oss-120b
BIPME_REPORT_MAX_INPUT_TOKENS=6000
BIPME_REPORT_MAX_OUTPUT_TOKENS=800
BIPME_REPORT_TIMEOUT_SECONDS=8.0
BIPME_REPORT_MAX_RETRIES=1
BIPME_REPORT_MAX_RETRY_AFTER_SECONDS=1.0
BIPME_REPORT_MAX_REQUEST_COST_USD=
BIPME_REPORT_MAX_DAILY_COST_USD=
BIPME_REPORT_INPUT_PRICE_USD_PER_MILLION=0.15
BIPME_REPORT_OUTPUT_PRICE_USD_PER_MILLION=0.60
BIPME_REPORT_PRICING_VERSION=groq-pricing-2026-11-09
BIPME_REPORT_MAX_CONCURRENCY=1

# Optional test-only opt-in; downloads model weights and is not used in CI.
# BIPME_RUN_LIVE_EMBEDDING_SMOKE=1
