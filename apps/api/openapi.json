  "info": {
    "title": "BipMe API",
    "version": "0.2.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/health": {
      "get": {
        "description": "Liveness only; not a database readiness check.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": {
                    "type": "string"
                  },
                  "title": "Response Health Api Health Get",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/creators/me/baseline": {
      "get": {
        "description": "Returns an exact metric-definition-unit-window baseline at an authorized cutoff. Requires COD-346's active server-verified creator session.",
        "operationId": "get_creator_baseline_api_v1_creators_me_baseline_get",
        "parameters": [
          {
            "in": "query",
            "name": "metric",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Metric",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "definition",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Definition",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "unit",
            "required": true,
            "schema": {
              "maxLength": 64,
              "minLength": 1,
              "title": "Unit",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "window_kind",
            "required": true,
            "schema": {
              "enum": [
                "mature_cumulative",
                "age_aligned"
              ],
              "title": "Window Kind",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "window_key",
            "required": true,
            "schema": {
              "maxLength": 100,
              "minLength": 1,
              "title": "Window Key",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "as_of",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date-time",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "As Of"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreatorBaselineResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Get the authenticated creator's historical baseline",
        "tags": [
          "creator analysis"
        ]
      }
    },
    "/api/v1/creators/me/draft-assessments": {
      "post": {
        "description": "Runs profile extraction, local embedding, same-creator comparable retrieval, historical outcome analysis and immutable Outlook persistence. Requires an Idempotency-Key and COD-346's active server-verified creator session.",
        "operationId": "create_draft_assessment_api_v1_creators_me_draft_assessments_post",
        "parameters": [
          {
            "in": "header",
            "name": "Idempotency-Key",
            "required": true,
            "schema": {
              "maxLength": 255,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DraftAnalysisRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftAnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Conflict"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Content"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Assess a draft against the creator's history",
        "tags": [
          "creator analysis"
        ]
      }
    },
    "/api/v1/creators/me/draft-assessments/{assessment_id}": {
      "get": {
        "description": "Returns only a saved assessment owned by the server-verified creator; foreign and absent IDs are indistinguishable.",
        "operationId": "get_draft_assessment_api_v1_creators_me_draft_assessments__assessment_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "assessment_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Assessment Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DraftAnalysisResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Forbidden"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not Found"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Read one of the authenticated creator's immutable assessments",
        "tags": [
          "creator analysis"
        ]
      }
    }
  }
}
