{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "api",
        "namespace": "team17",
        "labels": {
          "app.kubernetes.io/part-of": "bipme",
          "app.kubernetes.io/name": "api"
        }
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/part-of": "bipme",
            "app.kubernetes.io/name": "api"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "bipme",
              "app.kubernetes.io/name": "api"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/os": "linux",
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 120,
            "containers": [
              {
                "name": "api",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "image": "bipme-api:RELEASE_SHA",
                "command": [
                  "uvicorn",
                  "bipme.api.app:app",
                  "--host",
                  "0.0.0.0",
                  "--port",
                  "8000",
                  "--no-proxy-headers",
                  "--no-access-log"
                ],
                "env": [
                  {
                    "name": "BIPME_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "bipme-db",
                        "key": "BIPME_DATABASE_URL"
                      }
                    }
                  },
                  {
                    "name": "BIPME_CREATOR_ID",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "bipme-auth",
                        "key": "BIPME_CREATOR_ID"
                      }
                    }
                  },
                  {
                    "name": "BIPME_PRIVATE_LOGIN_SECRET",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "bipme-auth",
                        "key": "BIPME_PRIVATE_LOGIN_SECRET"
                      }
                    }
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "bipme-runtime"
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "100m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "650m",
                    "memory": "640Mi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/forge/check_db.py"
                    ]
                  },
                  "periodSeconds": 30,
                  "timeoutSeconds": 10,
                  "failureThreshold": 3
                },
                "volumeMounts": [
                  {
                    "name": "checks",
                    "mountPath": "/opt/forge",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8000
                  }
                ],
                "livenessProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": 8000
                  },
                  "periodSeconds": 30,
                  "timeoutSeconds": 3
                },
                "startupProbe": {
                  "httpGet": {
                    "path": "/api/health",
                    "port": 8000
                  },
                  "periodSeconds": 5,
                  "failureThreshold": 60
                }
              }
            ],
            "volumes": [
              {
                "name": "checks",
                "configMap": {
                  "name": "bipme-checks"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "worker",
        "namespace": "team17",
        "labels": {
          "app.kubernetes.io/part-of": "bipme",
          "app.kubernetes.io/name": "worker"
        }
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/part-of": "bipme",
            "app.kubernetes.io/name": "worker"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "bipme",
              "app.kubernetes.io/name": "worker"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/os": "linux",
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 10001,
              "runAsGroup": 10001,
              "fsGroup": 10001,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 120,
            "containers": [
              {
                "name": "worker",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "image": "bipme-api:RELEASE_SHA",
                "command": [
                  "python",
                  "-m",
                  "bipme.jobs"
                ],
                "env": [
                  {
                    "name": "BIPME_DATABASE_URL",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "bipme-db",
                        "key": "BIPME_DATABASE_URL"
                      }
                    }
                  }
                ],
                "envFrom": [
                  {
                    "configMapRef": {
                      "name": "bipme-worker"
                    }
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "50m",
                    "memory": "128Mi"
                  },
                  "limits": {
                    "cpu": "350m",
                    "memory": "384Mi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "python",
                      "/opt/forge/check_db.py"
                    ]
                  },
                  "periodSeconds": 30,
                  "timeoutSeconds": 10,
                  "failureThreshold": 3
                },
                "volumeMounts": [
                  {
                    "name": "checks",
                    "mountPath": "/opt/forge",
                    "readOnly": true
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "checks",
                "configMap": {
                  "name": "bipme-checks"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    },
    {
      "apiVersion": "apps/v1",
      "kind": "Deployment",
      "metadata": {
        "name": "app",
        "namespace": "team17",
        "labels": {
          "app.kubernetes.io/part-of": "bipme",
          "app.kubernetes.io/name": "app"
        }
      },
      "spec": {
        "replicas": 1,
        "revisionHistoryLimit": 3,
        "strategy": {
          "type": "Recreate"
        },
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/part-of": "bipme",
            "app.kubernetes.io/name": "app"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "bipme",
              "app.kubernetes.io/name": "app"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/os": "linux",
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 101,
              "runAsGroup": 101,
              "fsGroup": 101,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 120,
            "containers": [
              {
                "name": "app",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "image": "bipme-web:RELEASE_SHA",
                "env": [
                  {
                    "name": "BIPME_API_UPSTREAM",
                    "value": "http://api:8000"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 8080
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "25m",
                    "memory": "32Mi"
                  },
                  "limits": {
                    "cpu": "200m",
                    "memory": "96Mi"
                  }
                },
                "readinessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 5
                },
                "livenessProbe": {
                  "httpGet": {
                    "path": "/healthz",
                    "port": 8080
                  },
                  "periodSeconds": 20
                },
                "volumeMounts": [
                  {
                    "name": "nginx",
                    "mountPath": "/etc/nginx/templates",
                    "readOnly": true
                  },
                  {
                    "name": "nginx-conf",
                    "mountPath": "/etc/nginx/conf.d"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "nginx",
                "configMap": {
                  "name": "bipme-nginx"
                }
              },
              {
                "name": "nginx-conf",
                "emptyDir": {
                  "sizeLimit": "8Mi"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "16Mi"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
