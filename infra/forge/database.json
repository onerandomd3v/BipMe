{
  "apiVersion": "v1",
  "kind": "List",
  "items": [
    {
      "apiVersion": "apps/v1",
      "kind": "StatefulSet",
      "metadata": {
        "name": "db",
        "namespace": "team17",
        "labels": {
          "app.kubernetes.io/part-of": "bipme",
          "app.kubernetes.io/name": "db"
        }
      },
      "spec": {
        "serviceName": "db",
        "replicas": 1,
        "selector": {
          "matchLabels": {
            "app.kubernetes.io/part-of": "bipme",
            "app.kubernetes.io/name": "db"
          }
        },
        "template": {
          "metadata": {
            "labels": {
              "app.kubernetes.io/part-of": "bipme",
              "app.kubernetes.io/name": "db"
            }
          },
          "spec": {
            "automountServiceAccountToken": false,
            "nodeSelector": {
              "kubernetes.io/os": "linux",
              "kubernetes.io/arch": "amd64"
            },
            "securityContext": {
              "runAsNonRoot": true,
              "runAsUser": 999,
              "runAsGroup": 999,
              "fsGroup": 999,
              "seccompProfile": {
                "type": "RuntimeDefault"
              }
            },
            "terminationGracePeriodSeconds": 120,
            "containers": [
              {
                "name": "db",
                "securityContext": {
                  "allowPrivilegeEscalation": false,
                  "capabilities": {
                    "drop": [
                      "ALL"
                    ]
                  },
                  "readOnlyRootFilesystem": true
                },
                "image": "bipme-postgres:RELEASE_SHA",
                "args": [
                  "postgres",
                  "-c",
                  "shared_buffers=64MB",
                  "-c",
                  "max_connections=30",
                  "-c",
                  "work_mem=2MB",
                  "-c",
                  "maintenance_work_mem=32MB"
                ],
                "env": [
                  {
                    "name": "POSTGRES_DB",
                    "value": "bipme_demo"
                  },
                  {
                    "name": "POSTGRES_USER",
                    "value": "bipme"
                  },
                  {
                    "name": "POSTGRES_PASSWORD",
                    "valueFrom": {
                      "secretKeyRef": {
                        "name": "bipme-db",
                        "key": "POSTGRES_PASSWORD"
                      }
                    }
                  },
                  {
                    "name": "PGDATA",
                    "value": "/var/lib/postgresql/data/pgdata"
                  }
                ],
                "ports": [
                  {
                    "containerPort": 5432
                  }
                ],
                "resources": {
                  "requests": {
                    "cpu": "150m",
                    "memory": "256Mi"
                  },
                  "limits": {
                    "cpu": "600m",
                    "memory": "640Mi"
                  }
                },
                "readinessProbe": {
                  "exec": {
                    "command": [
                      "sh",
                      "-c",
                      "pg_isready -U \"$POSTGRES_USER\" -d \"$POSTGRES_DB\""
                    ]
                  },
                  "periodSeconds": 10,
                  "timeoutSeconds": 3
                },
                "volumeMounts": [
                  {
                    "name": "data",
                    "mountPath": "/var/lib/postgresql/data"
                  },
                  {
                    "name": "run",
                    "mountPath": "/var/run/postgresql"
                  },
                  {
                    "name": "tmp",
                    "mountPath": "/tmp"
                  }
                ]
              }
            ],
            "volumes": [
              {
                "name": "data",
                "persistentVolumeClaim": {
                  "claimName": "bipme-postgres"
                }
              },
              {
                "name": "run",
                "emptyDir": {
                  "sizeLimit": "8Mi"
                }
              },
              {
                "name": "tmp",
                "emptyDir": {
                  "sizeLimit": "32Mi"
                }
              }
            ]
          }
        }
      }
    }
  ]
}
